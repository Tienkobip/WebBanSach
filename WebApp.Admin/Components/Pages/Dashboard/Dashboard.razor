@page "/"
@page "/management/dashboard"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using WebApp.Admin.Services.Interfaces

@inject IDashboardClientService DashboardClientService
@inject IJSRuntime JSRuntime
@attribute [Authorize]

<main class="dashboard-container">
    <!-- Header -->
    <header class="dashboard-header">
        <h1 class="dashboard-title">Bảng Thống Kê & Phân Tích Hoạt Động (BI)</h1>
        <p class="dashboard-subtitle">Bấm vào từng thẻ chỉ số bên dưới để xem báo cáo chi tiết</p>
    </header>
    @if (isLoading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Đang tổng hợp dữ liệu báo cáo...</p>
        </div>
    }
    else if (dashBoardStateModel != null)
    {
        <!-- ================= KHU VỰC 1: 4 THẺ KPI ĐÓNG VAI TRÒ LÀ NÚT CHỌN TAB ================= -->
        <section class="kpi-grid">
            <!-- 1. Tab Tài chính -->
            <article class="kpi-card theme-revenue @(activeTab == "revenue" ? "active" : "")" @onclick='() => SelectTabAsync("revenue")'>
                <div class="kpi-icon"><i class="fa-solid fa-sack-dollar"></i></div>
                <div class="kpi-info">
                    <span class="kpi-label">Tổng Doanh Thu</span>
                    <strong class="kpi-value">@dashBoardStateModel.TotalRevenue.ToString("N0") ₫</strong>
                    <div class="kpi-sub">
                        <span>AOV: <strong>@dashBoardStateModel.AverageOrderValue.ToString("N0") ₫</strong></span>
                        <span class="badge @(dashBoardStateModel.RevenueGrowthPercent >= 0 ? "badge-success" : "badge-danger")">
                            @(dashBoardStateModel.RevenueGrowthPercent >= 0 ? "+" : "")@dashBoardStateModel.RevenueGrowthPercent% MoM
                        </span>
                    </div>
                </div>
            </article>
            <!-- 2. Tab Vận hành & Đơn hàng -->
            <article class="kpi-card theme-order @(activeTab == "orders" ? "active" : "")" @onclick='() => SelectTabAsync("orders")'>
                <div class="kpi-icon"><i class="fa-solid fa-truck-fast"></i></div>
                <div class="kpi-info">
                    <span class="kpi-label">Tổng Đơn Hàng</span>
                    <strong class="kpi-value">@dashBoardStateModel.TotalOrders đơn</strong>
                    <div class="kpi-sub">
                        <span class="text-success">Giao đạt: <strong>@dashBoardStateModel.OrderSuccessRate%</strong></span>
                        <span class="text-warning">Chờ duyệt: <strong>@dashBoardStateModel.PendingOrders</strong></span>
                    </div>
                </div>
            </article>
            <!-- 3. Tab Kho bãi & Sản phẩm -->
            <article class="kpi-card theme-warehouse @(activeTab == "warehouse" ? "active" : "")" @onclick='() => SelectTabAsync("warehouse")'>
                <div class="kpi-icon"><i class="fa-solid fa-boxes-stacked"></i></div>
                <div class="kpi-info">
                    <span class="kpi-label">Tồn Kho & Vốn</span>
                    <strong class="kpi-value">@dashBoardStateModel.TotalStockQuantity cuốn</strong>
                    <div class="kpi-sub">
                        <span>Đầu sách: <strong>@dashBoardStateModel.TotalProducts</strong> SKU</span>
                        <span>Vốn: <strong>@dashBoardStateModel.TotalInventoryValue.ToString("N0") ₫</strong></span>
                    </div>
                </div>
            </article>
            <!-- 4. Tab Khách hàng -->
            <article class="kpi-card theme-customer @(activeTab == "customers" ? "active" : "")" @onclick='() => SelectTabAsync("customers")'>
                <div class="kpi-icon"><i class="fa-solid fa-users-viewfinder"></i></div>
                <div class="kpi-info">
                    <span class="kpi-label">Khách Hàng</span>
                    <strong class="kpi-value">@dashBoardStateModel.TotalCustomers</strong>
                    <div class="kpi-sub">
                        <span class="text-primary">Mới: <strong>+@dashBoardStateModel.NewCustomersThisMonth</strong></span>
                        <span>Mua lại: <strong>@dashBoardStateModel.RepeatCustomerRate%</strong></span>
                    </div>
                </div>
            </article>
        </section>
        <!-- ================= KHU VỰC CHI TIẾT THAY ĐỔI THEO TAB ĐANG CHỌN ================= -->
        @if (activeTab == "revenue")
        {
            <!-- TAB 1: PHÂN TÍCH DOANH THU & TÀI CHÍNH -->
            <section class="detail-layout">
                <article class="panel panel-main">
                    <header class="panel-header">
                        <h2 class="panel-title text-primary"><i class="fa-solid fa-chart-column"></i> Xu hướng Doanh thu 6 Tháng gần nhất</h2>
                    </header>
                    <div class="chart-container">
                        <canvas id="revenueChart"></canvas>
                    </div>
                </article>
                <article class="panel panel-side">
                    <header class="panel-header">
                        <h2 class="panel-title"><i class="fa-solid fa-file-invoice-dollar"></i> Tổng kết Tài chính</h2>
                    </header>
                    <div class="stat-summary-list">
                        <div class="stat-summary-item">
                            <span>Doanh thu tháng này</span>
                            <strong class="text-primary">@dashBoardStateModel.RevenueThisMonth.ToString("N0") ₫</strong>
                        </div>
                        <div class="stat-summary-item">
                            <span>Giá trị trung bình đơn (AOV)</span>
                            <strong>@dashBoardStateModel.AverageOrderValue.ToString("N0") ₫</strong>
                        </div>
                        <div class="stat-summary-item">
                            <span>Tăng trưởng so tháng trước</span>
                            <strong class="@(dashBoardStateModel.RevenueGrowthPercent >= 0 ? "text-success" : "text-danger")">
                                @(dashBoardStateModel.RevenueGrowthPercent >= 0 ? "+" : "")@dashBoardStateModel.RevenueGrowthPercent%
                            </strong>
                        </div>
                    </div>
                </article>
            </section>
        }
        else if (activeTab == "orders")
        {
            <!-- TAB 2: VẬN HÀNH & ĐƠN HÀNG -->
            <section class="detail-layout">
                <article class="panel panel-main">
                    <header class="panel-header">
                        <h2 class="panel-title text-info"><i class="fa-solid fa-chart-pie"></i> Tỷ lệ Phân bổ Trạng thái Đơn hàng</h2>
                    </header>
                    <div class="chart-container">
                        <canvas id="orderStatusChart"></canvas>
                    </div>
                </article>
                <article class="panel panel-side">
                    <header class="panel-header">
                        <h2 class="panel-title"><i class="fa-solid fa-list-check"></i> Thống kê Vận chuyển</h2>
                    </header>
                    <div class="stat-summary-list">
                        <div class="stat-summary-item">
                            <span>Giao thành công</span>
                            <strong class="text-success">@dashBoardStateModel.CompletedOrders đơn (@dashBoardStateModel.OrderSuccessRate%)</strong>
                        </div>
                        <div class="stat-summary-item">
                            <span>Chờ duyệt / Đóng gói</span>
                            <strong class="text-warning">@(dashBoardStateModel.PendingOrders + dashBoardStateModel.ProcessingOrders) đơn</strong>
                        </div>
                        <div class="stat-summary-item">
                            <span>Đang vận chuyển</span>
                            <strong class="text-info">@dashBoardStateModel.ShippingOrders đơn</strong>
                        </div>
                        <div class="stat-summary-item">
                            <span>Hủy / Trả hàng</span>
                            <strong class="text-danger">@(dashBoardStateModel.CancelledOrders + dashBoardStateModel.ReturnedOrders) đơn</strong>
                        </div>
                    </div>
                </article>
            </section>
        }
        else if (activeTab == "warehouse")
        {
            <!-- TAB 3: KHO BÃI & THỂ LOẠI SÁCH -->
            <section class="detail-layout">
                <article class="panel panel-main">
                    <header class="panel-header">
                        <h2 class="panel-title text-danger"><i class="fa-solid fa-book-bookmark"></i> Phân bổ Doanh thu theo Thể loại Sách</h2>
                    </header>
                    <div class="chart-container">
                        <canvas id="categoryChart"></canvas>
                    </div>
                </article>
                <article class="panel panel-side">
                    <header class="panel-header">
                        <h2 class="panel-title"><i class="fa-solid fa-warehouse"></i> Tồn kho</h2>
                    </header>
                    <div class="stock-list">
                        <div class="stock-item theme-success">
                            <div class="stock-label">
                                <span>Tồn kho an toàn (>5 cuốn)</span>
                                <strong>@dashBoardStateModel.HealthyStockCount SKU</strong>
                            </div>
                            <div class="progress-track">
                                <div class="progress-fill" style="width: @(dashBoardStateModel.TotalProducts > 0 ? (dashBoardStateModel.HealthyStockCount * 100 / dashBoardStateModel.TotalProducts) : 0)%"></div>
                            </div>
                        </div>
                        <div class="stock-item theme-warning">
                            <div class="stock-label">
                                <span>Sắp hết hàng (1 - 5 cuốn)</span>
                                <strong>@dashBoardStateModel.LowStockCount SKU</strong>
                            </div>
                            <div class="progress-track">
                                <div class="progress-fill" style="width: @(dashBoardStateModel.TotalProducts > 0 ? (dashBoardStateModel.LowStockCount * 100 / dashBoardStateModel.TotalProducts) : 0)%"></div>
                            </div>
                        </div>
                        <div class="stock-item theme-danger">
                            <div class="stock-label">
                                <span>Đã hết hàng (0 cuốn)</span>
                                <strong>@dashBoardStateModel.OutOfStockCount SKU</strong>
                            </div>
                            <div class="progress-track">
                                <div class="progress-fill" style="width: @(dashBoardStateModel.TotalProducts > 0 ? (dashBoardStateModel.OutOfStockCount * 100 / dashBoardStateModel.TotalProducts) : 0)%"></div>
                            </div>
                        </div>
                    </div>
                    <div class="distribution-grid mt-3">
                        <div class="stat-mini">
                            <span class="stat-mini-label">Sách thương mại</span>
                            <strong class="stat-mini-value">@dashBoardStateModel.BookDistribution.CommercialBookCount</strong>
                        </div>
                        <div class="stat-mini">
                            <span class="stat-mini-label">Sách 0 đồng</span>
                            <strong class="stat-mini-value">@dashBoardStateModel.BookDistribution.FreeBookCount</strong>
                        </div>
                        <div class="stat-mini">
                            <span class="stat-mini-label">Sách ủng hộ</span>
                            <strong class="stat-mini-value">@dashBoardStateModel.BookDistribution.DonationBookCount</strong>
                        </div>
                    </div>
                </article>
            </section>
        }
        else if (activeTab == "customers")
        {
            <!-- TAB 4: PHÂN KHÚC KHÁCH HÀNG -->
            <section class="detail-layout">
                <article class="panel panel-main">
                    <header class="panel-header">
                        <h2 class="panel-title text-purple"><i class="fa-solid fa-users"></i> Phân khúc Khách hàng Mua sắm</h2>
                    </header>
                    <div class="chart-container">
                        <canvas id="customerChart"></canvas>
                    </div>
                </article>
                <article class="panel panel-side">
                    <header class="panel-header">
                        <h2 class="panel-title"><i class="fa-solid fa-chart-line"></i> Chỉ số Khách hàng</h2>
                    </header>
                    <div class="stat-summary-list">
                        <div class="stat-summary-item">
                            <span>Khách mới trong tháng</span>
                            <strong class="text-primary">+@dashBoardStateModel.NewCustomersThisMonth khách</strong>
                        </div>
                        <div class="stat-summary-item">
                            <span>Tỷ lệ khách mua lại (>= 2 đơn)</span>
                            <strong class="text-success">@dashBoardStateModel.RepeatCustomerRate%</strong>
                        </div>
                        <div class="stat-summary-item">
                            <span>Đã từng mua hàng</span>
                            <strong>@dashBoardStateModel.CustomersWithOrders khách</strong>
                        </div>
                        <div class="stat-summary-item">
                            <span>Chưa phát sinh đơn</span>
                            <strong class="text-muted">@dashBoardStateModel.CustomersWithoutOrders khách</strong>
                        </div>
                    </div>
                </article>
            </section>
        }
    }
</main>