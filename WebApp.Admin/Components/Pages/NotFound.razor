@page "/not-found"
@layout Layout.AuthLayout
@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView>
    <Authorized>
        <div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 60vh;">
            <h1 class="text-danger display-1 fw-bold">404</h1>
            <h3 class="mb-3">Trang bạn tìm kiếm không tồn tại!</h3>
            <a href="/management/dashboard" class="btn btn-primary mt-2">
                <i class="fa-solid fa-house me-2"></i> Quay về Bảng điều khiển
            </a>
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>