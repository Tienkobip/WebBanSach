@page "/management/forgot-password"
@using WebApp.Admin.Services.Interfaces
@using WebApp.Admin.Validation
@using WebApp.Shared.Dtos.Management.Auth

@inject NavigationManager Navigation
@inject IAuthClientService AuthClientService

<div class="auth-card">
    <EditForm EditContext="@editContext">
        <FluentValidator/>

        @if (currentStep == 1)
        {
            <h2 class="auth-title">QUÊN MẬT KHẨU</h2>
            <p class="auth-subtitle">Nhập email quản trị để nhận mã xác thực OTP</p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert-danger">
                    @errorMessage
                </div>
            }

            @if (validationErrors != null && validationErrors.Any())
            {
                <div class="alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in validationErrors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }

            <div class="form-group">
                <label for="email">Email tài khoản</label>
                <div class="input-group">
                    <InputText id="email" type="email" class="form-control" placeholder="admin@webbansach.com"
                               @bind-Value="forgotPasswordModel.Email" disabled="@isOtpSent" />

                    <button type="button" class="btn-otp"
                            disabled="@(!CanSendOtp || isSubmitting)"
                            @onclick="HandleSendOtp">
                        @(isTimerRunning ? $"{countdownSeconds}s" : "Gửi OTP")
                    </button>
                </div>
                <ValidationMessage For="@(() => forgotPasswordModel.Email)" />
            </div>

            <div class="form-group">
                <label for="otp">Mã xác thực OTP</label>
                <InputText id="otp" class="form-control" placeholder="Nhập 6 số OTP"
                           @bind-Value="forgotPasswordModel.OtpCode" disabled="@(!isOtpSent)" maxlength="6" />
                <ValidationMessage For="@(() => forgotPasswordModel.OtpCode)" />
            </div>

            <button type="button" class="btn-submit" disabled="@(!CanVerifyOtp || isSubmitting)" @onclick="HandleVerifyOtp">
                @if (isSubmitting)
                {
                    <span>ĐANG XỬ LÝ...</span>
                }
                else
                {
                    <span>XÁC NHẬN MÃ OTP</span>
                }
            </button>
        }
        else
        {
            <h2 class="auth-title">ĐẶT LẠI MẬT KHẨU</h2>
            <p class="auth-subtitle">Tạo mật khẩu mới cho tài khoản của bạn</p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert-danger">
                    @errorMessage
                </div>
            }

            @if (validationErrors != null && validationErrors.Any())
            {
                <div class="alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in validationErrors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }

            <div class="form-group">
                <label for="newPassword">Mật khẩu mới</label>
                <div class="password-group">
                    <InputText id="newPassword" type="@(showNewPassword ? "text" : "password")" class="form-control" placeholder="••••••••"
                               @bind-Value="forgotPasswordModel.NewPassword" />
                    <button type="button" class="btn-eye" @onclick="ToggleShowNewPassword" aria-label="Toggle password visibility">
                        @if (showNewPassword)
                        {
                            <!-- SVG Mắt đóng (Hide) -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        }
                        else
                        {
                            <!-- SVG Mắt mở (Show) -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        }
                    </button>
                </div>
                <ValidationMessage For="@(() => forgotPasswordModel.NewPassword)" />
            </div>

            <div class="form-group">
                <label for="confirmPassword">Xác nhận mật khẩu mới</label>
                <div class="password-group">
                    <InputText id="confirmPassword" type="@(showConfirmPassword ? "text" : "password")" class="form-control" placeholder="••••••••"
                               @bind-Value="forgotPasswordModel.ConfirmNewPassword" />
                    <button type="button" class="btn-eye" @onclick="ToggleShowConfirmPassword" aria-label="Toggle password visibility">
                        @if (showConfirmPassword)
                        {
                            <!-- SVG Mắt đóng (Hide) -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        }
                        else
                        {
                            <!-- SVG Mắt mở (Show) -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        }
                    </button>
                </div>
                <ValidationMessage For="@(() => forgotPasswordModel.ConfirmNewPassword)" />
            </div>

            <button type="button" class="btn-submit" disabled="@(!CanResetPassword || isSubmitting)" @onclick="HandleResetPassword">
                @if (isSubmitting)
                {
                    <span>ĐANG XỬ LÝ...</span>
                }
                else
                {
                    <span>LƯU MẬT KHẨU</span>
                }
            </button>
        }

        <div class="auth-footer">
            <a href="/management/login" class="back-link">← Quay lại đăng nhập</a>
        </div>
    </EditForm>
</div>